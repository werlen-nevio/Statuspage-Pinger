# ============================================================================
# Checks
# ============================================================================
# Eine Zeile pro URL:  name|url|statuspage-component-id
# Der Name wird im Anruf vorgelesen — also sprechbar halten ("Datenbank", nicht "db-01-prod").
# Die Component-ID ist optional; ohne sie wird geprueft und alarmiert, nur die
# Statuspage bleibt unberuehrt.
# IDs auflisten mit: npm run components
CHECKS="api|https://api.example.com/health|abc123def456
web|https://example.com|ghi789jkl012
docs|https://docs.example.com"

CHECK_INTERVAL_MS=60000
CHECK_TIMEOUT_MS=10000

# Wie viele Durchlaeufe hintereinander ein Zustand bestaetigt sein muss, bevor er
# veroeffentlicht wird. Verhindert Flackern bei einzelnen Aussetzern.
FAILURE_THRESHOLD=2
SUCCESS_THRESHOLD=1

# Antwortzeit ab der eine Seite als "degraded_performance" gilt. 0 = aus.
DEGRADED_MS=0

# ============================================================================
# Atlassian Statuspage
# ============================================================================
# API-Key: Manage account -> API info     Page-ID: Page settings -> Page ID
STATUSPAGE_API_KEY=
STATUSPAGE_PAGE_ID=

# ============================================================================
# Discord (Webhook, kein Bot noetig)
# ============================================================================
# Serveinstellungen -> Integrationen -> Webhooks -> Neuer Webhook -> URL kopieren
DISCORD_WEBHOOK_URL=

# Wer bei einem Ausfall gepingt werden soll: "@everyone", "@here" oder eine
# Rolle als "<@&ROLLEN_ID>". Leer = nie pingen.
# Gepingt wird NUR bei major_outage — nicht bei der Entwarnung und nicht bei
# degraded. Ein Ping bei jeder Kleinigkeit fuehrt dazu, dass der Kanal
# stummgeschaltet wird, und ein stummer Kanal ist nachts um drei nichts wert.
# Voraussetzung: der Webhook braucht im Kanal das Recht "@everyone, @here und
# alle Rollen erwaehnen" — sonst wird die Nachricht gepostet, pingt aber nicht.
DISCORD_MENTION=

# ============================================================================
# Anruf per SIP  (kostenlos, keine Telefonie-Gebuehren)
# ============================================================================
# Den Anruf baut Asterisk auf, gesteuert ueber AMI. Die SIP-Zugangsdaten und die
# gesamte SIP-/Medien-Konfiguration stehen in /etc/asterisk/pjsip.conf, nicht
# hier. Was hier steht, sagt nur: ob ueberhaupt angerufen wird, wen, und wie
# hartnaeckig.
#
# Gratis-Variante: zwei Konten auf sip.linphone.org anlegen (Linphone-App ->
# "Konto erstellen"), eines fuer das Handy, eines fuer den Server. Anrufe
# zwischen Konten desselben Dienstes laufen ueber das Internet und kosten nichts.
#
# SIP_URI     = die Identitaet, von der aus angerufen wird (Konto des Servers)
# CALL_TARGET = wer angerufen wird (Konto auf deinem Handy)
# Beide leer lassen = keine Anrufe.
SIP_URI=sip:pinger-abc123@sip.linphone.org
CALL_TARGET=sip:nevio-abc123@sip.linphone.org

# Nur zur Dokumentation. Die Kopie, die Asterisk benutzt, steht in
# /etc/asterisk/pjsip.conf unter [linphone-auth] und muss dort mit geaendert
# werden — der Pinger liest dieses Feld nicht.
SIP_PASSWORD=

# ============================================================================
# Asterisk Manager Interface (AMI)
# ============================================================================
# Gegenstueck zu /etc/asterisk/manager.conf. Nur ueber 127.0.0.1 erreichbar;
# das Secret muss auf beiden Seiten identisch sein.
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=statuspage
AMI_SECRET=

# Der PJSIP-Endpoint aus pjsip.conf, ueber den gewaehlt wird.
ASTERISK_ENDPOINT=linphone

# Bei welchen Zustaenden angerufen wird (Komma-getrennt).
# major_outage = down, degraded_performance = langsam, operational = Entwarnung
CALL_ON=major_outage

# Quittieren: diese Taste beendet die Anrufversuche.
CALL_ACK_DIGIT=1
CALL_RETRIES=3
CALL_RETRY_DELAY_MS=180000
# Wie lange ein bereits angenommener Anruf laufen darf. Die Ansage ist ~42 s
# lang, danach laesst der Dialplan noch 15 s zum Tastendruck.
CALL_TIMEOUT_MS=90000
# Wie lange es beim Ziel klingeln darf. Nicht kuerzer setzen: das Handy wird
# erst per Push geweckt, und Flexisips Fork-Timeout liegt bei ~90 s.
CALL_DIAL_TIMEOUT_MS=90000

# Aufbau der Ansage: N Wiederholungen mit Pause, danach Stille zum Tastendruck.
CALL_REPEATS=3
CALL_REPEAT_GAP_SEC=2
CALL_TAIL_SILENCE_SEC=8

# ============================================================================
# Sprachausgabe (Piper, laeuft offline auf diesem Server)
# ============================================================================
PIPER_BIN=/opt/piper/piper
PIPER_MODEL=/opt/piper/voices/de_DE-thorsten-medium.onnx

# ============================================================================
# Pfade / Interna (koennen normalerweise so bleiben)
# ============================================================================
# CALL_WAV_PATH=/srv/statuspage/data/alert.wav
# STATE_PATH=/srv/statuspage/data/state.json
