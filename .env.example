# ============================================================================
# Checks
# ============================================================================
# One line per URL:  name|url|statuspage-component-id
# The name is read out during the call, so keep it pronounceable. The voice is
# German, so e.g. "Datenbank" rather than "db-01-prod".
# The component id is optional; without it the URL is still checked and alerted
# on, it just never touches Statuspage.
# List the ids with: npm run components
CHECKS="api|https://api.example.com/health|abc123def456
web|https://example.com|ghi789jkl012
docs|https://docs.example.com"

CHECK_INTERVAL_MS=60000
CHECK_TIMEOUT_MS=10000

# How many consecutive cycles a state must hold before it is published.
# Prevents flapping on single hiccups.
FAILURE_THRESHOLD=2
SUCCESS_THRESHOLD=1

# Response time above which a check counts as "degraded_performance". 0 = off.
DEGRADED_MS=0

# ============================================================================
# Atlassian Statuspage (leave empty to disable)
# ============================================================================
# API key: Manage account -> API info     Page ID: Page settings -> Page ID
STATUSPAGE_API_KEY=
STATUSPAGE_PAGE_ID=

# ============================================================================
# Discord (webhook, no bot needed; leave empty to disable)
# ============================================================================
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Who gets pinged on an outage: "@everyone", "@here" or a role as
# "<@&ROLE_ID>". Empty = never ping.
# Pings ONLY on major_outage — not on recovery and not on degraded. Pinging on
# every little thing gets the channel muted, and a muted channel is worth
# nothing at three in the morning.
# Requirement: the webhook needs the "Mention @everyone, @here and All Roles"
# permission in the channel — otherwise the message is posted but doesn't ping.
DISCORD_MENTION=

# ============================================================================
# Phone call over SIP  (free, no telephony charges; leave empty to disable)
# ============================================================================
# Asterisk places the call, driven over AMI. The SIP credentials and the whole
# SIP/media configuration live in /etc/asterisk/pjsip.conf, not here. The
# settings below only say whether to call at all, whom, and how persistently.
#
# Free option: create two accounts on sip.linphone.org (Linphone app ->
# "Create account"), one for your phone, one for the server. Calls between
# accounts on the same service go over the internet and cost nothing.
#
# SIP_URI     = the identity the call comes from (the server's account)
# CALL_TARGET = who gets called (the account on your phone)
# e.g.  SIP_URI=sip:pinger-abc123@sip.linphone.org
#       CALL_TARGET=sip:phone-abc123@sip.linphone.org
# Leave both empty = no calls.
SIP_URI=
CALL_TARGET=

# For reference only. The copy Asterisk uses lives in /etc/asterisk/pjsip.conf
# under [linphone-auth] and has to be changed there as well — the pinger does
# not read this field.
SIP_PASSWORD=

# ============================================================================
# Asterisk Manager Interface (AMI)
# ============================================================================
# Counterpart of /etc/asterisk/manager.conf. Only reachable on 127.0.0.1;
# the secret must be identical on both sides.
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=statuspage
AMI_SECRET=

# The PJSIP endpoint from pjsip.conf to dial through.
ASTERISK_ENDPOINT=linphone

# Which states trigger a call (comma separated).
# major_outage = down, degraded_performance = slow, operational = recovered
CALL_ON=major_outage

# Acknowledge: this key stops the call attempts.
CALL_ACK_DIGIT=1
CALL_RETRIES=3
CALL_RETRY_DELAY_MS=180000
# How long an answered call may run. The announcement is ~42 s long; after it
# the dialplan leaves another 15 s for the keypress.
CALL_TIMEOUT_MS=90000
# How long the target may ring. Don't set it lower: the phone is woken by push
# first, and Flexisip's fork timeout is ~90 s.
CALL_DIAL_TIMEOUT_MS=90000

# Announcement layout: N repeats with a pause, then silence for the keypress.
CALL_REPEATS=3
CALL_REPEAT_GAP_SEC=2
CALL_TAIL_SILENCE_SEC=8

# ============================================================================
# Voice (Piper, runs offline on this server)
# ============================================================================
PIPER_BIN=/opt/piper/piper
PIPER_MODEL=/opt/piper/voices/de_DE-thorsten-medium.onnx

# ============================================================================
# Paths / internals (can usually stay as they are)
# ============================================================================
# CALL_WAV_PATH=/srv/statuspage/data/alert.wav
# STATE_PATH=/srv/statuspage/data/state.json
